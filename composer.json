{
    "name": "memberflow/plorea",
    "description": "Plorea Payments SDK for Laravel — payment links, refunds, stored payment methods and subscriptions.",
    "keywords": ["laravel", "plorea", "payments", "subscriptions", "sdk"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MemberFlow Team",
            "email": "hello@memberflow.no"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.7",
        "laravel/boost": "^2.6",
        "laravel/pint": "^1.25",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0",
        "rector/rector": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "MemberFlow\\Plorea\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MemberFlow\\Plorea\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1024M",
        "format": [
            "@rector",
            "@pint"
        ],
        "boost": "vendor/bin/testbench boost:install --guidelines --skills --no-interaction",
        "pint": "vendor/bin/pint --ansi",
        "rector": "vendor/bin/rector process",
        "test": "vendor/bin/phpunit",
        "check": [
            "@pint",
            "vendor/bin/rector process --dry-run",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "MemberFlow\\Plorea\\PloreaServiceProvider"
            ],
            "aliases": {
                "Plorea": "MemberFlow\\Plorea\\Facades\\Plorea"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
