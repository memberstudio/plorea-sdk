# Copy to workbench/.env (git-ignored) and fill in. Never commit real values.
APP_KEY=
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

PLOREA_API_KEY=
PLOREA_ENVIRONMENT=test
PLOREA_TENANT_ID=
PLOREA_PLATFORM=
PLOREA_ADYEN_CLIENT_KEY=
PLOREA_WEBHOOKS_ENABLED=false

# A merchant org number Plorea's test environment accepts for payment links.
PLOREA_WORKBENCH_MERCHANT_ORG_NR=
# A non-https return URL to try on native sessions.
PLOREA_WORKBENCH_APP_RETURN_URL=plorea-workbench://checkout/return
